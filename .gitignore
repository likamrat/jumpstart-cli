# Go-specific gitignore for jumpstart-cli project

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
js
jumpstart-cli

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Go workspace file
go.work
go.work.sum

# Dependency directories (remove the comment below to include it)
vendor/

# Go mod cache
go.sum.bak

# Test coverage files and reports
coverage/
*.coverprofile
coverage.out
coverage.html
coverage_func.txt
test_output.log
*.cover

# Build and deployment artifacts
dist/
build/
release/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
tmp/
*.tmp
*.temp

# Log files and testing artifacts
logs/
*.log
test-artifacts.log
cleanup-*.log

# Local environment files
.env
.env.local
.env.*.local

# Azure and cloud deployment files (keep templates, ignore instances)
*.azure/
.azure/

# Azure CLI cache and profiles
.azurecache/
.azure-cli/

# Local development and testing
test-results/
integration-test-results/

# Backup files
*.bak
*.backup

# Node.js (if any frontend tooling is added)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker
.dockerignore

# Local scripts that shouldn't be committed
local-*
*.local.*
